{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Regras de negócio",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": {"type": "string"},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "title", "category", "applies_to", "statement"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "title": {"type": "string"},
                     "category": {"enum": ["status", "denominator", "window", "time", "attribution", "precision", "governance"]},
                     "applies_to": {"oneOf": [{"const": "all"}, {"type": "array", "minItems": 1, "items": {"type": "string"}}]},
                     "statement": {"type": "string", "minLength": 10}}}}
  }
}
