{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Métrica do catálogo semântico",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "business_name", "description", "formula", "source", "grain", "expression", "base_filter", "joins",
               "value_type", "denominator", "status_rule", "time_basis", "allowed_dimensions", "applicable_filters",
               "owner", "version", "tests"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "business_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "formula": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["system", "tables"],
               "properties": {"system": {"const": "duckdb"}, "tables": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "grain": {"enum": ["order", "item", "growth"]},
    "kind": {"enum": ["growth"]},
    "base_metric": {"type": "string"},
    "expression": {"type": "string", "minLength": 1},
    "base_filter": {"type": "string"},
    "joins": {"type": "array", "items": {"type": "string"}},
    "value_type": {"enum": ["money", "count", "ratio"]},
    "denominator": {"type": "string", "minLength": 1},
    "status_rule": {"type": "string", "minLength": 1},
    "time_basis": {"type": "string", "minLength": 1},
    "window": {"type": "object", "additionalProperties": false, "required": ["days", "anchor"],
               "properties": {"days": {"type": "integer", "minimum": 1}, "anchor": {"const": "date_to"}}},
    "required_dimensions": {"type": "array", "items": {"type": "string"}},
    "allowed_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "applicable_filters": {"type": "object", "additionalProperties": false, "required": ["dimensions", "date_range"],
                           "properties": {"dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                                          "date_range": {"type": "boolean"}}},
    "owner": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
              "required": ["id", "type", "description"],
              "properties": {"id": {"type": "string"}, "type": {"enum": ["reconciliation", "invariant"]},
                             "description": {"type": "string"}, "reference_sql": {"type": "string"},
                             "tolerance": {"type": "string"}, "dimensions": {"type": "array", "items": {"type": "string"}},
                             "invariant": {"enum": ["additive_by_dimension", "min_value", "between", "not_greater_than", "first_row_null"]},
                             "dimension": {"type": "string"}, "min": {"type": "string"}, "max": {"type": "string"},
                             "other_metric": {"type": "string"}}}}
  }
}
