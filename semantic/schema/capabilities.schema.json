{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ferramentas permitidas ao agente",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "grantee", "requester", "tools"],
  "properties": {
    "system": {"type": "string"}, "grantee": {"type": "string"}, "requester": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "description"],
              "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "description": {"type": "string"}}}}
  }
}
