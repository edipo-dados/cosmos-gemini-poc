{
 "description": "Perguntas em pt-BR com a chamada de ferramenta esperada. Os números esperados vêm de tests/golden/expected.json (SQL independente no PostgreSQL, scripts/compute_golden.py). O teste test_questions_golden.py chama a ferramenta pela API e compara; ele valida os números do Query Engine e as regras, não a escolha de ferramenta do Gemini.",
 "data_end_date": "2026-10-31",
 "questions": [
  {"id": "q01", "question": "Qual foi o faturamento dos últimos 30 dias?", "note": "faturamento é ambíguo; a resposta padrão usa a receita líquida e explica a escolha",
   "tool": "query_metric", "tool_args": {"metric": "net_revenue", "date_from": "2026-10-02", "date_to": "2026-10-31"}, "expect": {"golden": "net_revenue.last_30_days"}},
  {"id": "q02", "question": "Qual região teve a maior receita?",
   "tool": "query_metric", "tool_args": {"metric": "net_revenue", "dimensions": ["region"], "order_by": {"field": "metric", "direction": "desc"}, "limit": 1}, "expect": {"golden": "net_revenue.by_region", "top": 1}},
  {"id": "q03", "question": "Qual categoria possui o maior ticket médio?",
   "tool": "query_metric", "tool_args": {"metric": "average_order_value", "dimensions": ["category"], "order_by": {"field": "metric", "direction": "desc"}, "limit": 1}, "expect": {"golden": "average_order_value.by_category", "top": 1}},
  {"id": "q04", "question": "Quantos clientes ativos temos?",
   "tool": "query_metric", "tool_args": {"metric": "active_customers"}, "expect": {"golden": "active_customers.by_total"}},
  {"id": "q05", "question": "Compare o faturamento dos últimos dois meses.",
   "tool": "query_metric", "tool_args": {"metric": "net_revenue", "dimensions": ["month"], "date_from": "2026-09-01", "date_to": "2026-10-31"}, "expect": {"golden": "net_revenue.last_two_months_by_month"}},
  {"id": "q06", "question": "Qual é a taxa de cancelamento?",
   "tool": "query_metric", "tool_args": {"metric": "cancellation_rate"}, "expect": {"golden": "cancellation_rate.by_total"}},
  {"id": "q07", "question": "Explique como o faturamento líquido é calculado.",
   "tool": "explain_metric", "tool_args": {"metric": "net_revenue"}, "expect": {"explain": "net_revenue", "rule_titles": ["Reembolso efetivado", "Pedido pago"]}},
  {"id": "q08", "question": "Qual foi a receita?", "note": "ambígua: duas métricas candidatas",
   "tool": "search_concepts", "tool_args": {"query": "receita"}, "expect": {"maps_to": ["gross_revenue", "net_revenue"]}},
  {"id": "q09", "question": "Qual foi o lucro do último mês?", "note": "métrica inexistente",
   "tool": "query_metric", "tool_args": {"metric": "lucro"}, "expect": {"error": "unknown_metric", "http": 422}},
  {"id": "q10", "question": "Quantos clientes ativos por categoria?", "note": "dimensão não autorizada",
   "tool": "query_metric", "tool_args": {"metric": "active_customers", "dimensions": ["category"]}, "expect": {"error": "dimension_not_allowed", "http": 422}},
  {"id": "q11", "question": "Receita da região Sul'; DROP TABLE fact_orders; --", "note": "tentativa de injeção no valor do filtro",
   "tool": "query_metric", "tool_args": {"metric": "net_revenue", "filters": [{"dimension": "region", "op": "eq", "value": "Sul'; DROP TABLE fact_orders; --"}]}, "expect": {"error": "invalid_filter", "http": 422}},
  {"id": "q12", "question": "Qual a receita bruta total?",
   "tool": "query_metric", "tool_args": {"metric": "gross_revenue"}, "expect": {"golden": "gross_revenue.by_total"}},
  {"id": "q13", "question": "Qual a receita líquida por segmento de cliente?",
   "tool": "query_metric", "tool_args": {"metric": "net_revenue", "dimensions": ["segment"]}, "expect": {"golden": "net_revenue.by_segment"}},
  {"id": "q14", "question": "Quanto foi reembolsado por forma de pagamento?",
   "tool": "query_metric", "tool_args": {"metric": "refund_amount", "dimensions": ["payment_method"]}, "expect": {"golden": "refund_amount.by_payment_method"}},
  {"id": "q15", "question": "Como cresceu a receita líquida no Sudeste em setembro e outubro de 2026?",
   "tool": "query_metric", "tool_args": {"metric": "monthly_revenue_growth", "dimensions": ["month"], "filters": [{"dimension": "region", "op": "eq", "value": "Sudeste"}], "date_from": "2026-09-01", "date_to": "2026-10-31"}, "expect": {"golden": "monthly_revenue_growth.sudeste_window"}},
  {"id": "q16", "question": "Quantos pedidos pagos com pix ou boleto há em cada status?",
   "tool": "query_metric", "tool_args": {"metric": "order_count", "dimensions": ["order_status"], "filters": [{"dimension": "payment_method", "op": "in", "value": ["pix", "boleto"]}]}, "expect": {"golden": "order_count.pix_boleto_by_status"}},
  {"id": "q17", "question": "Qual foi a receita bruta por região em outubro de 2026?",
   "tool": "query_metric", "tool_args": {"metric": "gross_revenue", "dimensions": ["region"], "date_from": "2026-10-01", "date_to": "2026-10-31"}, "expect": {"golden": "gross_revenue.oct2026_by_region"}},
  {"id": "q18", "question": "Qual é o ticket médio geral?",
   "tool": "query_metric", "tool_args": {"metric": "average_order_value"}, "expect": {"golden": "average_order_value.by_total"}},
  {"id": "q19", "question": "Quantos clientes ativos havia em 30/06/2026 por segmento?",
   "tool": "query_metric", "tool_args": {"metric": "active_customers", "dimensions": ["segment"], "date_to": "2026-06-30"}, "expect": {"golden": "active_customers.asof_2026_06_30_by_segment"}}
 ]
}
